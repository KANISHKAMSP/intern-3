
import java.util.Scanner;

public class Main {

    static Scanner sc = new Scanner(System.in);

    static String[] food = {
        "Pizza", "Burger", "Biriyani", "Sandwich", "Fried Rice"
    };

    static int[] price = {200, 100, 180, 80, 150};

    static int[] cart = new int[5];

    public static void main(String[] args) {

        int choice;

        do {
            System.out.println("\n===== FOOD DELIVERY APP =====");
            System.out.println("1. View Food Menu");
            System.out.println("2. Add Food to Cart");
            System.out.println("3. View Cart");
            System.out.println("4. Place Order");
            System.out.println("5. Exit");
            System.out.print("Enter your choice: ");

            choice = sc.nextInt();

            switch (choice) {
                case 1:
                    displayMenu();
                    break;

                case 2:
                    addToCart();
                    break;

                case 3:
                    viewCart();
                    break;

                case 4:
                    placeOrder();
                    break;

                case 5:
                    System.out.println("Thank you for using our app!");
                    break;

                default:
                    System.out.println("Invalid choice!");
            }

        } while (choice != 5);

        sc.close();
    }

    static void displayMenu() {
        System.out.println("\n----- FOOD MENU -----");

        for (int i = 0; i < food.length; i++) {
            System.out.println(
                (i + 1) + ". " + food[i] + " - Rs." + price[i]
            );
        }
    }

    static void addToCart() {
        displayMenu();

        System.out.print("Enter food number: ");
        int item = sc.nextInt();

        if (item >= 1 && item <= food.length) {
            System.out.print("Enter quantity: ");
            int quantity = sc.nextInt();

            if (quantity > 0) {
                cart[item - 1] += quantity;
                System.out.println(food[item - 1] + " added to cart!");
            } else {
                System.out.println("Quantity must be positive.");
            }
        } else {
            System.out.println("Invalid food number!");
        }
    }

    static void viewCart() {
        int total = 0;

        System.out.println("\n----- YOUR CART -----");

        for (int i = 0; i < food.length; i++) {
            if (cart[i] > 0) {
                int amount = cart[i] * price[i];

                System.out.println(
                    food[i] + " x " + cart[i] + " = Rs." + amount
                );

                total += amount;
            }
        }

        System.out.println("Total Amount: Rs." + total);
    }

    static void placeOrder() {
        int total = 0;

        for (int i = 0; i < food.length; i++) {
            total += cart[i] * price[i];
        }

        if (total == 0) {
            System.out.println("Your cart is empty!");
        } else {
            viewCart();
            System.out.println("Order placed successfully!");
            System.out.println("Amount to pay: Rs." + total);

            for (int i = 0; i < cart.length; i++) {
                cart[i] = 0;
            }
        }
    }
}
